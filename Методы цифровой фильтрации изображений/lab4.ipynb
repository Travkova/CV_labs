   "source": [
    "d0_values = [10, 30, 60]\n",
    "\n",
    "rows, cols = img.shape\n",
    "y, x = np.ogrid[:rows, :cols]\n",
    "D2 = (x - cols//2)**2 + (y - rows//2)**2\n",
    "\n",
    "f = np.fft.fft2(img)\n",
    "fshift = np.fft.fftshift(f)\n",
    "\n",
    "plt.figure(figsize=(14, 8))\n",
    "\n",
    "# Исходное изображение\n",
    "plt.subplot(2, 4, 1)\n",
    "plt.imshow(img, cmap='gray')\n",
    "plt.title('Исходное')\n",
    "plt.axis('off')\n",
    "\n",
    "# Пустая ячейка для симметрии\n",
    "plt.subplot(2, 4, 5)\n",
    "plt.axis('off')\n",
    "\n",
    "for i, D0 in enumerate(d0_values):\n",
    "    mask = 1 - np.exp(-D2 / (2 * D0**2))\n",
    "    fshift_filtered = fshift * mask\n",
    "    f_ishift = np.fft.ifftshift(fshift_filtered)\n",
    "    img_back = np.fft.ifft2(f_ishift)\n",
    "    result = cv2.normalize(np.abs(img_back), None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)\n",
    "\n",
    "    # Маска\n",
    "    plt.subplot(2, 4, i + 2)\n",
    "    plt.imshow(mask, cmap='gray', vmin=0, vmax=1)\n",
    "    plt.title(f'Маска, D0={D0}')\n",
    "    plt.axis('off')\n",
    "\n",
    "    # Результат\n",
    "    plt.subplot(2, 4, i + 6)\n",
    "    plt.imshow(result, cmap='gray')\n",
    "    plt.title(f'Результат, D0={D0}')\n",
    "    plt.axis('off')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
